# ---------------------------------------------------------------------------
# user-os-mcp — LOCAL DEV SECRETS
#
# Wrangler reads this file automatically for `wrangler dev`. It is the Worker
# equivalent of .env. It is gitignored and must NEVER be committed, pasted into
# chat, or logged.
#
# For PRODUCTION do not use this file — run instead, once per variable:
#     wrangler secret put <NAME>
# ---------------------------------------------------------------------------

# Neon connection string.
# 🚨 MUST be the NON-OWNER `app_user` role, not the Neon owner.
#    No table in the OS schema sets FORCE ROW LEVEL SECURITY, so an owner
#    connection bypasses all 55 RLS policies and app.current_user_id does
#    nothing. app_user keeps RLS on.
# Local dev should point at the Neon TEST branch, never production.
DATABASE_URL=postgresql://app_user:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Clerk OAuth. Every /mcp request must carry a Clerk OAuth access token (JWT).
# Issuer and JWKS URL are public; the secret key is used server-side only, to
# look up the signed-in account's verified email (Backend API).
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_replace-me

# HMAC key for attachment upload links. Any long random string, e.g.:
#     openssl rand -hex 32
# Changing it invalidates upload links already handed out (they last 15 min).
UPLOAD_SIGNING_KEY=replace-with-a-long-random-string

# Service account used ONLY to look up the signed-in caller in `users` during
# sign-in (that table is RLS-protected). Tools never run as it. Defaults to the
# OS SYSTEM user (…ff) if blank; the dedicated U-SYS-MCP user is …fe.
GS_ACTOR_UID=00000000-0000-0000-0000-0000000000fe
