{
  "name": "user-os-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "perms:check": "esbuild scripts/perms-check.ts --bundle --platform=node --format=esm --outfile=.wrangler/perms-check.mjs --log-level=warning && node .wrangler/perms-check.mjs",
    "e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=esm --packages=external --outfile=.wrangler/e2e.mjs --log-level=warning && node .wrangler/e2e.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "jose": "^6.2.12",
    "mcp-handler": "^1.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.97.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260908.1": true
  }
}
